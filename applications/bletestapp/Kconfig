if BT

config BT_ZEPHYR
	bool "Use Zephyr BLE host stack"
	help
	  Build with the Zephyr BLE host stack over HCI instead of the
	  default Ceva (Alif ROM) BLE host stack.

# Must precede Kconfig.zephyr: the first matching choice default wins.
choice BT_STACK_SELECTION
	default BT_HCI if BT_ZEPHYR
	default BT_CUSTOM
endchoice

endif # BT

source "Kconfig.zephyr"

config DATA_STRING_LENGTH
	int "Data string size"
	range 5 250
	default 243
	help
	  Defines how many bytes will be sent in a notification


menu "Logging"

module = MAIN
module-str = main
source "subsys/logging/Kconfig.template.log_config"

endmenu # "Logging"
