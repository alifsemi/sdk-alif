config TEST_ADC_DIFFERENTIAL
	bool "To Test ADC in differential mode"

config TEST_ADC_CONTINUOUS
	bool "To Test ADC in continuous mode"

config TEST_ADC_MULTICH
	bool "To Test ADC in multi Channel mode"
	select TEST_ADC_CONTINUOUS
	depends on !TEST_ADC_DIFFERENTIAL || TEST_ADC24
	help
	  Alif ADC does not support multi-channel scan in single-shot mode.
	  Enabling this option also enables continuous conversion. Include
	  the continuous overlay together with the multich overlay, or use
	  a multich overlay that sets CONTINUOUS_CONVERSION.
	  Differential multi-channel is valid with ADC24 only. ADC12 has no
	  test for that combination, so it cannot be selected.

config TEST_ADC24
	bool "To Enable ADC24 testcases"

config TEST_ADC_CH0
	bool "To enable ADC channel 0 testcase"
	help
	  Enable with -DCONFIG_TEST_ADC_CH0=y on the west build command.

