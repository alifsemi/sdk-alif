	bool "To enable ADC channel 2 testcase"
	help
	  Enable with -DCONFIG_TEST_ADC_CH2=y on the west build command.

config TEST_ADC_CH3
	bool "To enable ADC channel 3 testcase"
	help
	  Enable with -DCONFIG_TEST_ADC_CH3=y on the west build command.

config TEST_ADC_CH4
	bool "To enable ADC channel 4 testcase"
	help
	  Enable with -DCONFIG_TEST_ADC_CH4=y on the west build command.

config TEST_ADC_CH5
	bool "To enable ADC channel 5 testcase"
	help
	  Enable with -DCONFIG_TEST_ADC_CH5=y on the west build command.

config TEST_ADC_CH6
	bool "To enable ADC channel 6 (temperature) testcase"
	help
