config TEST_ADC_DIFFERENTIAL
	bool "To Test ADC in differential mode"

config TEST_ADC_CONTINUOUS
	bool "To Test ADC in continuous mode"

config TEST_ADC_MULTICH
	bool "To Test ADC in multi Channel mode"
	select TEST_ADC_CONTINUOUS
	depends on !TEST_ADC_DIFFERENTIAL || TEST_ADC24
	help
	  Alif ADC does not support multi-channel scan in single-shot mode.
	  Enabling this option also enables continuous conversion. Include
	  the continuous overlay together with the multich overlay, or use
	  a multich overlay that sets CONTINUOUS_CONVERSION.
	  Differential multi-channel is valid with ADC24 only. ADC12 has no
	  test for that combination, so it cannot be selected.

config TEST_ADC24
	bool "To Enable ADC24 testcases"

config TEST_ADC_DAC
	bool "ADC reads DAC0 loopback test"
	depends on !TEST_ADC_MULTICH && (TEST_ADC24 || !TEST_ADC_DIFFERENTIAL)
	select DAC
	help
	  Enable with -DCONFIG_TEST_ADC_DAC=y. Requires an ADC+DAC overlay
	  (alif_adc1_dac0.overlay preferred on B1, or alif_adc12_dac0 /
	  alif_adc24_dac0) so DT alias dac is present. Wire DAC0 P2_3 to
	  the ADC pin described in test_adc_dac.c / README.

config TEST_ADC_THRESHOLD
	bool "ADC comparator threshold and window test"
	help
	  Enable with -DCONFIG_TEST_ADC_THRESHOLD=y. Append a
	  thresh_above, thresh_below, or thresh_window overlay to the
	  matching base ADC overlay.

config TEST_ADC_PGA
	bool "ADC PGA gain test"
	help
	  Enable with -DCONFIG_TEST_ADC_PGA=y. Append a gain overlay
	  (alif_adc1_gain0.overlay, gain12, gain24, gain36, or gain42).
	  Do not combine with CONFIG_TEST_ADC_DAC or CONFIG_TEST_ADC_THRESHOLD.
	  Optionally pass -DCONFIG_TEST_ADC_CHn=y to pick the channel
	  (default channel 1).

config TEST_ADC_CH0
	bool "To enable ADC channel 0 testcase"
	help
	  Enable with -DCONFIG_TEST_ADC_CH0=y on the west build command.

config TEST_ADC_CH1
	bool "To enable ADC channel 1 testcase"
	help
	  Enable with -DCONFIG_TEST_ADC_CH1=y on the west build command.

config TEST_ADC_CH2
	bool "To enable ADC channel 2 testcase"
	help
	  Enable with -DCONFIG_TEST_ADC_CH2=y on the west build command.

config TEST_ADC_CH3
	bool "To enable ADC channel 3 testcase"
	help
	  Enable with -DCONFIG_TEST_ADC_CH3=y on the west build command.

config TEST_ADC_CH4
	bool "To enable ADC channel 4 testcase"
	help
	  Enable with -DCONFIG_TEST_ADC_CH4=y on the west build command.

config TEST_ADC_CH5
	bool "To enable ADC channel 5 testcase"
	help
	  Enable with -DCONFIG_TEST_ADC_CH5=y on the west build command.

config TEST_ADC_CH6
	bool "To enable ADC channel 6 (temperature) testcase"
	help
	  Enable with -DCONFIG_TEST_ADC_CH6=y on the west build command.

config TEST_ADC_CH7
	bool "To enable ADC channel 7 testcase"
	help
	  Enable with -DCONFIG_TEST_ADC_CH7=y on the west build command.

source "Kconfig.zephyr"
