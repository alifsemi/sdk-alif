/ {
	chosen {
		zephyr,i3c = &i3c0;
	};
};

&i3c0 {
	status = "okay";
	od-thigh-min-ns = <41>;
	od-tlow-min-ns = <200>;
	target-mode;
};

/* Board SCL/SDA recovery pins are on gpio7. */
&gpio7 {
	status = "okay";
};
