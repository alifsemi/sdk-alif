mainmenu "UART Test Suite Configuration"

source "Kconfig.zephyr"

config TEST_INTERNAL_LB
	bool "Enable UART internal loopback test suite"
	help
	  Build src/uart_internal_loopback.c and register
	  uart_internal_loopback.

config TEST_EXTERNAL_LB
	bool "Enable UART external loopback test suite"
	help
	  Build src/uart_external_loopback.c. Requires a physical TX-RX
	  connection between zephyr,devnode1 and zephyr,devnode2.

config TEST_UART_RTSCTS
	bool "Enable UART RTS/CTS flow control test suite"
	help
	  Builds src/uart_internal_loopback.c (same source as
	  TEST_INTERNAL_LB) so test_interrupt_internal_loopback_flowctrl_rts_cts
	  is compiled, and registers uart_RTSCTS_suite. Apply snippet
	  uart0-rts-cts (and boards/alif_uart.overlay) so hw-flow-control
	  is present on zephyr,devnode1.

config TEST_UART_DMA
	bool "Enable UART DMA async API test suite"
	help
	  Build src/uart_dma_tests.c. Also enable the DMA / async-API
	  options in dma.conf (EXTRA_CONF_FILE=dma.conf) and apply
	  snippet alif-uart-dma so zephyr,devnode1 is DMA-wired
	  (per-board overlay selected by the snippet).
