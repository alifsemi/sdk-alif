config TEST_GT911_INTERACTIVE
	bool "Enable interactive GT911 touch tests"
	default y
	help
	  Prompt an operator to tap, drag, and use multi-touch on the
	  panel. This is the default for a board run. Set n for
	  unattended CI; those cases skip.

source "Kconfig.zephyr"
