choice XIP_DEVICE
	prompt "XIP device under test"
	optional
	default TEST_PSRAM
	help
	  Selects which device-specific cases are built on top of the shared
	  XIP suite in src/main.c. Pass CONFIG_TEST_PSRAM=y or
	  CONFIG_TEST_HYPERRAM=y. With neither set, only the shared cases run.

config TEST_PSRAM
	bool "APS512XXN PSRAM"
	help
	  Build src/test_psram.c (identity and latency-code vs bus-speed).
	  Use boards/alif_psram.overlay.

config TEST_HYPERRAM
	bool "S80KS2564 HyperRAM"
	help
	  Build src/test_s80ks2564.c (datasheet identity, tCSM, RWDS, and
	  refresh). Use boards/alif_hex_s80ks.overlay.

endchoice

config TEST_PSRAM_FULL_CHIP
	bool "Walk the entire PSRAM in the full-memory XIP test"
	depends on TEST_PSRAM
	help
	  Build test_full_memory_rw_test, which writes and verifies every
	  byte of DT property size (64 MiB on APS512XXN). Leave disabled
	  for functional CI; enable only on bring-up.

config TEST_HYPERRAM_FULL_CHIP
	bool "Walk the entire HyperRAM in the full-memory XIP test"
	depends on TEST_HYPERRAM
	help
	  Build test_full_memory_rw_test, which writes and verifies every
	  byte of DT property size (32 MiB on S80KS2564). Leave disabled
	  for functional CI; enable only on bring-up.

source "Kconfig.zephyr"
