 *
 * Linker snippet: place the ExecuTorch buffers that the Ethos-U NPU reads and
 * writes into the SRAM1 memory region.
 *
 * SRAM1 is mapped MT_NORMAL with no MATTR_CACHE_* bits in
 * soc/alif/ensemble/common/mmu_regions.c, i.e. non-cacheable, so the CPU and
 * the NPU share a coherent view without any cache maintenance. This matters on
 * APSS because Alif's Ethos-U cache callbacks (modules/hal/alif/drivers/ethos_u)
 * are built for Cortex-M only, leaving the driver's flush/invalidate hooks as
 * no-ops here.
 *
 * The SRAM1 memory region itself is generated by LINKER_DT_REGIONS() from the
 * "zephyr,memory-region" property of the sram1 node, which the
 * ethos-u85-apss-enable snippet adds. Input sections are matched both with and
 * without a leading dot so the placement does not depend on GNU ld's
 * orphan-section name matching.
 */

SECTION_DATA_PROLOGUE(SRAM1.et_npu, (NOLOAD),)
{
	. = ALIGN(16);
	*(SRAM1.et_npu)
	*(SRAM1.et_npu.*)
	*(.SRAM1.et_npu)
	*(.SRAM1.et_npu.*)
	. = ALIGN(16);
} GROUP_LINK_IN(SRAM1)
