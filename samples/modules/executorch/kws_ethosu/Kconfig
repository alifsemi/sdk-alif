source "Kconfig.zephyr"

# Enable the FPU for the Helium/MVE optimisations, but only where one exists:
# CONFIG_FPU depends on CPU_HAS_FPU, which the RTSS (Cortex-M55) cores select
# and APSS (Cortex-A32) does not. Assigning it from prj.conf would abort the
# APSS build, because Zephyr promotes "assigned 'y' but got 'n'" Kconfig
# warnings to errors. The hard-float ABI needs no assignment of its own --
# FP_HARDABI is already the default of the "Floating point ABI" choice, which
# becomes active as soon as FPU is set.
configdefault FPU
	default y if CPU_HAS_FPU

menu "executorch KWS sample configuration"

config EXECUTORCH_METHOD_ALLOCATOR_POOL_SIZE
	int "Method allocator pool size in bytes"
	default 65536 if SOC_FAMILY_BALLETTO
	default 65536 if SOC_SERIES_E1C
	default 1572864
	depends on EXECUTORCH
	help
	  Size of the method allocator pool in bytes. This memory is used
	  for allocating ExecuTorch method instances and their metadata.
	  Default is 64KB for boards without SRAM0 (B1, E1C) which use DTCM,
	  and 1.5MB for boards with SRAM0 (E7/E8).

	  On APSS (Cortex-A32) the pool lives in .bss, which the linker places
	  in SRAM0, so the 1.5MB default applies there too.

config EXECUTORCH_TEMP_ALLOCATOR_POOL_SIZE
	int "Temporary allocator pool size in bytes"
	default 32768 if SOC_FAMILY_BALLETTO
	default 32768 if SOC_SERIES_E1C
	default 32768
	depends on EXECUTORCH
	help
	  Size of the temporary allocator pool in bytes. This memory is used
	  for temporary allocations during model execution such as Ethos-U
	  scratch memory. 32KB is sufficient; the NPU needs ~22KB scratch for
	  the KWS model.

	  On RTSS this must be in DTCM for all boards, because the NPU reaches
	  it through the global alias that local_to_global() computes. On APSS
	  it is placed in non-cacheable SRAM1 instead; see src/main.cpp.

config KWS_ETHOSU_IMAGE_IN_OSPI
	bool
	default y if FLASH_BASE_ADDRESS >= 0xa0000000 && FLASH_BASE_ADDRESS < 0xe0000000
	help
	  Set when the application image is linked to execute in place from
	  an OSPI XIP window (OSPI0 at 0xA0000000 or OSPI1 at 0xC0000000),
	  i.e. the Secure Enclave boots the image directly from OSPI flash.

config KWS_ETHOSU_MODEL_COPY_TO_RAM
	bool "Copy the .pte model to RAM before loading it"
	default y if KWS_ETHOSU_IMAGE_IN_OSPI
	help
	  Copy the .pte (including the Vela command stream and weights of the
	  Ethos-U delegate) from its link location to a RAM buffer at startup,
	  and load the ExecuTorch program from the RAM copy. The delegate hands
	  the NPU pointers into the loaded program, so the NPU then only reads
	  RAM. Enabled by default when the image executes from OSPI XIP:
	  Ethos-U fetches from the OSPI XIP window set up by the boot firmware
	  end in an NPU command stream parse error.

config KWS_ETHOSU_MODEL_RAM_SECTION
	string "Linker section of the RAM model copy"
	depends on KWS_ETHOSU_MODEL_COPY_TO_RAM
	default "SRAM1.et_npu" if APSS
	default ".bss.et_model_ram"
	help
	  Linker input section for the RAM copy of the model. On RTSS the
	  default places it in DTCM together with the Ethos-U scratch, which
	  the NPU reaches through the global alias. On APSS it goes into the
	  non-cacheable SRAM1 region used for the other NPU-visible buffers.

endmenu
