/* Note:
 * Extra overlay: E7 / E8 HE only — retarget to DMA2 (not HP: no dma2).
 * Applied on top of lptimer_dma0_e7_e8.overlay.
 *
 *   west build ... -- -DEXTRA_DTC_OVERLAY_FILE=boards/lptimer_dma2_e7_e8_he.overlay
 *
 * LPTIMER0_DMA_REQ → DMA2_REQ[0], EVTRTR2 group 0 (group 1 is LPUTIMER).
 */

#include <zephyr/dt-bindings/dma/alif_dma_event_router.h>

&dma2 {
	status = "okay";
};

&evtrtr2 {
	status = "okay";
};

&timer0 {
	dmas = <&evtrtr2 ALIF_DMA_ENCODE(0, 0, 1) 0>,
	       <&evtrtr2 ALIF_DMA_ENCODE(0, 0, 1) 5>;
	dma-names = "rx", "neg";
};
