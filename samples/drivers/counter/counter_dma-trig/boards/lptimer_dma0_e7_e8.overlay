/* Note:
 * E7 / E8 HE and HP — DMA0.
 * LPTIMER0 timeout → LPTIMER0_DMA_REQ → DMA0_REQ[0], EVTRTR0 group 1.
 * Handshake 1 (EVTRTR ACK). Second dmas cell is req 5 (negative test).
 */

#include <zephyr/dt-bindings/dma/alif_dma_event_router.h>

&timer0 {
	status = "okay";
	dma-trig;
	dmas = <&evtrtr0 ALIF_DMA_ENCODE(0, 1, 1) 0>,
	       <&evtrtr0 ALIF_DMA_ENCODE(0, 1, 1) 5>;
	dma-names = "rx", "neg";
};

&dma0 {
	status = "okay";
};

&evtrtr0 {
	status = "okay";
};
