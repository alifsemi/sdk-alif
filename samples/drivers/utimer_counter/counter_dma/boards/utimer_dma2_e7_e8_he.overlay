#include <zephyr/dt-bindings/dma/alif_dma_event_router.h>

&dma2 {
	status = "okay";
};

&evtrtr2 {
	status = "okay";
};

&utimer0 {
	dmas = <&evtrtr2 ALIF_DMA_ENCODE(0, 2, 1) 0>,
	       <&evtrtr2 ALIF_DMA_ENCODE(0, 2, 1) 5>;
	dma-names = "rx", "neg";
};
